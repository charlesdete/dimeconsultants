# ─────────────────────────────────────────────
#  Dime Consultants — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# Application
NODE_ENV=production
PORT=3030

# ─── SMTP Configuration ───────────────────────
# Your outgoing mail server details.
# Common providers:
#   Gmail:      smtp.gmail.com  / port 587 (TLS) or 465 (SSL)
#   Zoho:       smtp.zoho.com   / port 587
#   Mailgun:    smtp.mailgun.org / port 587
#   SendGrid:   smtp.sendgrid.net / port 587
#   Custom VPS: your mail server hostname

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@dimeconsultants.africa
SMTP_PASS=your-smtp-password-here

# ─── Recipient List ───────────────────────────
# Email address(es) that receive contact form submissions.
# For multiple recipients, separate with commas (no spaces).
# Example: hello@dimeconsultants.co.ke,info@dimeconsultants.africa

RECIPIENT_EMAIL=hello@dimeconsultants.co.ke
